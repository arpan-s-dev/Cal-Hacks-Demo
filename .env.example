# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# This app talks to Supabase over HTTPS with the anon key (RLS is the gate).
# If you later add a server-only Postgres URL (Prisma / postgres.js) on Vercel,
# use the Transaction pooler (port 6543, ?pgbouncer=true), not session/direct
# port 5432. Session mode will exhaust connections on serverless.
